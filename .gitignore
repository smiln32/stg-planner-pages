# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Project-local runtimes and caches
.uv-cache/
.uv-python/

# Generated planner output
*.generated.html
/output/
dist/

# A stage's output is one planner run: the creator's work, not the product. The folders
# stay, held by a .gitkeep, because a stage with no output folder is not a stage.
stages/*/output/*
!stages/*/output/.gitkeep

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and secrets
.env
.env.*
!.env.example
